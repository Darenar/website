---
import Layout from '../../layouts/Layout.astro';
import PaperVisual from '../../components/PaperVisual.astro';
import { conferences, papers, profile } from '../../data/site';
---

<Layout title="Research — Vladislav Pyzhov" description="Working papers, results and conference presentations by finance PhD candidate Vladislav Pyzhov.">
	<div class="page-shell">
		<header class="page-hero research-hero rule">
			<p class="eyebrow">Academic research · UTS Business School</p>
			<div class="page-hero-grid">
				<h1>Research and working papers.</h1>
				<div><p class="lede">PhD research in empirical asset pricing, sustainable finance, media sentiment and machine learning.</p><a class="text-link" href={profile.uts} target="_blank" rel="noreferrer">UTS researcher profile <span>↗</span></a></div>
			</div>
		</header>

		<section class="section rule papers-section">
			<div class="section-head"><div><p class="eyebrow">Working papers</p><h2>Papers.</h2></div><p class="section-intro">Plain-language summaries, main results and links to available manuscripts.</p></div>
			<div class="papers">
				{papers.map((paper, index) => (
					<article class="paper">
						<div class="paper-num">0{index + 1}</div>
						<div class="paper-main">
							<p class="paper-meta">{paper.year ? `${paper.year} · ${paper.status}` : paper.status}</p>
							<h3>{paper.title}</h3>
							<p class="authors">{paper.authors}</p>
							<PaperVisual paper={paper} />
							<div class="paper-copy"><p><strong>Abstract.</strong> {paper.summary}</p></div>
							<div class="btn-row">
								{paper.article && <a class="btn primary" href={paper.article}>Visual explainer <span>→</span></a>}
								{paper.url && <a class="btn" href={paper.url} target="_blank" rel="noreferrer">Open paper <span>↗</span></a>}
							</div>
						</div>
					</article>
				))}
			</div>
		</section>

		<section id="conferences" class="section rule">
			<div class="section-head"><div><p class="eyebrow">Academic events</p><h2>Conferences & presentations.</h2></div><p class="section-intro">Selected conference appearances and academic presentations.</p></div>
			<div class="conference-list">
				{conferences.map((item) => (
					<article><p class="conference-year">{item.year}</p><div><h3>{item.name}</h3><p>{item.place}</p></div><p class="conference-note">{item.note}</p></article>
				))}
			</div>
		</section>
	</div>
</Layout>

<style>
	.research-hero h1 { max-width: 9ch; }
	.papers { border-top: 1px solid var(--ink); }
	.paper { display: grid; grid-template-columns: 8rem 1fr; padding: clamp(2.5rem, 6vw, 6rem) 0; border-bottom: 1px solid var(--line); }
	.paper-num { color: var(--orange); font: .68rem/1.5 var(--mono); }
	.paper-main { max-width: 1000px; }
	.paper-meta, .authors { color: var(--muted); font: .66rem/1.5 var(--mono); text-transform: uppercase; }
	.paper h3 { max-width: 18ch; margin: 1rem 0; font: 400 clamp(2.5rem, 6vw, 6rem)/.9 var(--serif); letter-spacing: -.06em; }
	.paper-copy { margin-top: 2rem; }
	.paper-copy p { margin: 0; color: var(--muted); font-size: 1rem; }
	.paper-copy strong { color: var(--ink); }
	.conference-list { border-top: 1px solid var(--ink); }
	.conference-list article { display: grid; grid-template-columns: .35fr 1.3fr .65fr; gap: 2rem; padding: 1.8rem 0; border-bottom: 1px solid var(--line); }
	.conference-list h3 { margin: 0; font: 400 clamp(1.3rem, 2.2vw, 2rem)/1.1 var(--serif); }
	.conference-list p { margin: .4rem 0 0; color: var(--muted); }
	.conference-year, .conference-note { font: .65rem/1.5 var(--mono); text-transform: uppercase; }
	@media (max-width: 700px) { .paper { grid-template-columns: 1fr; gap: 1rem; } .conference-list article { grid-template-columns: 1fr; gap: .6rem; } }
</style>
