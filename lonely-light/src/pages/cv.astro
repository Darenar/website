---
import Layout from '../layouts/Layout.astro';
import { profile } from '../data/site';
import { withBase } from '../utils/paths';

const cvUrl = withBase('/Vladislav-Pyzhov-CV.pdf');
---

<Layout title="CV — Vladislav Pyzhov" description="Curriculum vitae of Vladislav Pyzhov, Machine Learning Engineer and Finance PhD Candidate.">
	<div class="cv page-shell">
		<header class="cv-head rule">
			<div><p class="eyebrow">Curriculum vitae</p><h1>{profile.name}</h1><p>{profile.title}<br />{profile.location}</p></div>
			<div class="cv-actions">
				<a class="btn primary" href={cvUrl} download>Download PDF <span>↓</span></a>
				<a class="btn" href={cvUrl} target="_blank">Open PDF <span>↗</span></a>
			</div>
		</header>
		<div class="pdf-frame">
			<object data={cvUrl} type="application/pdf" aria-label="Vladislav Pyzhov curriculum vitae">
				<p>Your browser cannot display the PDF here. <a href={cvUrl}>Open the CV directly.</a></p>
			</object>
		</div>
	</div>
</Layout>

<style>
	.cv { padding-block: 4rem 8rem; }
	.cv-head { display: flex; justify-content: space-between; gap: 3rem; align-items: end; padding-block: 4rem; }
	.cv-head h1 { margin: 0; font: 400 clamp(3.5rem, 8vw, 7rem)/.9 var(--serif); letter-spacing: -.06em; }
	.cv-head p { color: var(--muted); }
	.cv-actions { display: flex; flex-wrap: wrap; gap: .6rem; }
	.pdf-frame { height: min(82vh, 1120px); border: 1px solid var(--ink); background: var(--paper-2); }
	.pdf-frame object { display: block; width: 100%; height: 100%; }
	.pdf-frame p { padding: 2rem; }
	@media (max-width: 700px) { .cv-head { display: grid; grid-template-columns: 1fr; } .pdf-frame { height: 70vh; } }
</style>
