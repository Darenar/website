---
const tracks = [
	{
		title: 'Devil on My Shoulder',
		videoId: 'hdgG4TOJT4o',
		playlistId: 'OLAK5uy_nAYFmqtfeXGq_vDx0li97Me1NcorlPk44',
		url: 'https://www.youtube.com/watch?v=hdgG4TOJT4o&list=OLAK5uy_nAYFmqtfeXGq_vDx0li97Me1NcorlPk44',
	},
	{
		title: 'Port Wine',
		videoId: 'RDyCJx_yNV4',
		playlistId: 'OLAK5uy_kGmoPHNBvoicSf063DGrq7YJypBJTIY8E',
		url: 'https://www.youtube.com/watch?v=RDyCJx_yNV4&list=OLAK5uy_kGmoPHNBvoicSf063DGrq7YJypBJTIY8E',
	},
	{
		title: 'Keeper of the Light',
		videoId: 'zq0frCYREZs',
		playlistId: 'OLAK5uy_nROmrg4hMyJjZt5XOVGC_Fe5sMBiGwS_U',
		url: 'https://www.youtube.com/watch?v=zq0frCYREZs&list=OLAK5uy_nROmrg4hMyJjZt5XOVGC_Fe5sMBiGwS_U',
	},
	{
		title: 'Dream',
		videoId: 'dsbUunQIFZI',
		playlistId: 'OLAK5uy_kbqXL54KNL0WbZA4GMocwJ9tKMsLx3W18',
		url: 'https://www.youtube.com/watch?v=dsbUunQIFZI&list=OLAK5uy_kbqXL54KNL0WbZA4GMocwJ9tKMsLx3W18',
	},
	{
		title: 'Round & Round',
		videoId: 'qAgbL96Xac8',
		playlistId: 'OLAK5uy_merFxQ458ePH2DQfvOegLjqbPv-Zw9EDk',
		url: 'https://www.youtube.com/watch?v=qAgbL96Xac8&list=OLAK5uy_merFxQ458ePH2DQfvOegLjqbPv-Zw9EDk',
	},
];
---

<div class="music-player" data-accentors-player>
	<div class="music-screen">
		<iframe
			data-music-frame
			src={`https://www.youtube-nocookie.com/embed/${tracks[0].videoId}?list=${tracks[0].playlistId}`}
			title={`${tracks[0].title} by Accentors`}
			loading="lazy"
			allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
			allowfullscreen
		></iframe>
	</div>
	<div class="music-copy">
		<p class="music-kicker" data-track-position>Accentors · 01 / 05</p>
		<h3 data-track-title>{tracks[0].title}</h3>
		<p>Music I make with my brother. Choose a track below and play it without leaving the site.</p>
		<div class="music-links">
			<a class="btn primary" data-track-link href={tracks[0].url} target="_blank" rel="noreferrer">YouTube <span>↗</span></a>
			<a class="btn" href="https://open.spotify.com/search/Accentors" target="_blank" rel="noreferrer">Spotify <span>↗</span></a>
		</div>
	</div>
	<div class="track-browser" aria-label="Accentors songs">
		<button class="track-arrow" type="button" data-track-previous aria-label="Previous song">←</button>
		<div class="track-strip">
			{tracks.map((track, index) => (
				<button
					class:list={['track-choice', { active: index === 0 }]}
					type="button"
					data-track-choice
					data-video-id={track.videoId}
					data-playlist-id={track.playlistId}
					data-track-url={track.url}
					data-track-title={track.title}
					aria-pressed={index === 0 ? 'true' : 'false'}
				>
					<span>{String(index + 1).padStart(2, '0')}</span>
					<strong>{track.title}</strong>
				</button>
			))}
		</div>
		<button class="track-arrow" type="button" data-track-next aria-label="Next song">→</button>
	</div>
</div>

<script>
	document.querySelectorAll('[data-accentors-player]').forEach((player) => {
		const frame = player.querySelector('[data-music-frame]');
		const title = player.querySelector('[data-track-title]');
		const position = player.querySelector('[data-track-position]');
		const link = player.querySelector('[data-track-link]');
		const choices = [...player.querySelectorAll('[data-track-choice]')];
		let activeIndex = 0;

		function selectTrack(nextIndex, autoplay = true) {
			if (!(frame instanceof HTMLIFrameElement) || choices.length === 0) return;
			activeIndex = (nextIndex + choices.length) % choices.length;
			const choice = choices[activeIndex];
			if (!(choice instanceof HTMLButtonElement)) return;
			const videoId = choice.dataset.videoId;
			const playlistId = choice.dataset.playlistId;
			const trackTitle = choice.dataset.trackTitle || 'Accentors';
			if (videoId && playlistId) frame.src = `https://www.youtube-nocookie.com/embed/${videoId}?list=${playlistId}${autoplay ? '&autoplay=1' : ''}`;
			frame.title = `${trackTitle} by Accentors`;
			if (title) title.textContent = trackTitle;
			if (position) position.textContent = `Accentors · ${String(activeIndex + 1).padStart(2, '0')} / ${String(choices.length).padStart(2, '0')}`;
			if (link instanceof HTMLAnchorElement && choice.dataset.trackUrl) link.href = choice.dataset.trackUrl;
			choices.forEach((button, index) => {
				button.classList.toggle('active', index === activeIndex);
				button.setAttribute('aria-pressed', index === activeIndex ? 'true' : 'false');
			});
			choice.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
		}

		choices.forEach((choice, index) => choice.addEventListener('click', () => selectTrack(index)));
		player.querySelector('[data-track-previous]')?.addEventListener('click', () => selectTrack(activeIndex - 1));
		player.querySelector('[data-track-next]')?.addEventListener('click', () => selectTrack(activeIndex + 1));
	});
</script>

<style>
	.music-player { border: 1px solid var(--ink); background: var(--white); }
	.music-screen { position: relative; min-width: 0; aspect-ratio: 16 / 9; background: var(--ink); }
	.music-screen iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
	.music-copy { display: grid; min-width: 0; grid-template-columns: minmax(0, 1fr) auto; align-items: center; column-gap: 2rem; padding: clamp(1.15rem, 2.5vw, 1.7rem); border-top: 1px solid var(--ink); }
	.music-kicker { margin: 0; color: var(--muted); font: 650 .58rem/1.45 var(--mono); letter-spacing: .05em; text-transform: uppercase; }
	.music-copy h3 { grid-column: 1; margin: .45rem 0 .55rem; font: 400 clamp(1.8rem, 3.6vw, 3.25rem)/.95 var(--serif); letter-spacing: -.045em; }
	.music-copy > p:not(.music-kicker) { grid-column: 1; max-width: 34rem; margin: 0; color: var(--muted); font-size: .78rem; line-height: 1.55; }
	.music-links { display: flex; grid-column: 2; grid-row: 1 / 4; flex-wrap: wrap; justify-content: flex-end; gap: .55rem; margin: 0; }
	.track-browser { display: grid; grid-template-columns: 2.8rem minmax(0, 1fr) 2.8rem; border-top: 1px solid var(--ink); }
	.track-strip { display: flex; min-width: 0; overflow-x: auto; scroll-behavior: smooth; scrollbar-width: none; }
	.track-strip::-webkit-scrollbar { display: none; }
	.track-arrow, .track-choice { border: 0; color: var(--ink); background: transparent; cursor: pointer; }
	.track-arrow { border-right: 1px solid var(--line); font-size: 1rem; }
	.track-arrow:last-child { border-right: 0; border-left: 1px solid var(--line); }
	.track-choice { display: grid; min-width: 9.5rem; flex: 1 0 9.5rem; gap: .35rem; padding: .85rem .9rem; border-right: 1px solid var(--line); text-align: left; transition: color .2s, background .2s; }
	.track-choice span { color: var(--muted); font: .52rem/1 var(--mono); }
	.track-choice strong { overflow: hidden; font: 650 .58rem/1.3 var(--mono); text-overflow: ellipsis; text-transform: uppercase; white-space: nowrap; }
	.track-choice:hover, .track-choice.active { color: white; background: var(--ink); }
	.track-choice.active span { color: #82aaff; }
	@media (max-width: 650px) {
		.music-copy { grid-template-columns: 1fr; }
		.music-links { grid-column: 1; grid-row: auto; justify-content: flex-start; margin-top: 1rem; }
		.track-browser { grid-template-columns: 2.5rem minmax(0, 1fr) 2.5rem; }
	}
</style>
