---
import { profile } from '../data/site';
---

<header class="site-header">
	<a class="wordmark" href="/" aria-label={`${profile.name}, home`}>
		<span class="wordmark-mark">VP</span>
		<span class="wordmark-name">Vladislav Pyzhov</span>
	</a>
	<nav class="header-links" aria-label="Profile links">
		<a class="header-email" href={`mailto:${profile.email}`}>{profile.email}</a>
		<a href="/Vladislav-Pyzhov-CV.pdf" target="_blank">CV</a>
		<a href={profile.linkedin} target="_blank" rel="noreferrer">LinkedIn</a>
		<a href={profile.github} target="_blank" rel="noreferrer">GitHub</a>
	</nav>
</header>
