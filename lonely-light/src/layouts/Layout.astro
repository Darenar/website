---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { withBase } from '../utils/paths';

interface Props {
	title?: string;
	description?: string;
	image?: string;
	showFooter?: boolean;
}

const {
	title = 'Vladislav Pyzhov — Senior Machine Learning Engineer and Data Scientist',
	description = 'The work, research and open-source projects of Vladislav Pyzhov, Senior Machine Learning Engineer, Data Scientist and Finance PhD Candidate in Sydney.',
	image = '/vladislav-pyzhov.png',
	showFooter = true,
} = Astro.props;

const imageUrl = image.startsWith('http') ? image : withBase(image);
const absoluteImageUrl = new URL(imageUrl, Astro.site).href;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#f4f1e9" />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={absoluteImageUrl} />
		<link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to content</a>
		<Header />
		<main id="main"><slot /></main>
		{showFooter && <Footer />}
	</body>
</html>

<style is:global>
	:root {
		--paper: #f4f1e9;
		--paper-2: #ebe7de;
		--ink: #111312;
		--muted: #696c66;
		--line: rgba(17, 19, 18, 0.16);
		--violet: #7867ff;
		--orange: #ff6b45;
		--green: #188f76;
		--white: #fffdf7;
		--serif: 'Iowan Old Style', 'Palatino Linotype', Palatino, 'Times New Roman', serif;
		--sans: Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
		--mono: 'SFMono-Regular', Consolas, 'Liberation Mono', monospace;
		--gutter: clamp(1.25rem, 4vw, 4.5rem);
		--max: 1440px;
	}

	* { box-sizing: border-box; }
	html { scroll-behavior: smooth; background: var(--paper); }
	body {
		margin: 0;
		min-width: 320px;
		background:
			linear-gradient(90deg, transparent 0 49.92%, rgba(17, 19, 18, .028) 50%, transparent 50.08%),
			var(--paper);
		color: var(--ink);
		font-family: var(--sans);
		font-size: 16px;
		line-height: 1.55;
		-webkit-font-smoothing: antialiased;
	}

	::selection { color: var(--white); background: var(--violet); }
	a { color: inherit; }
	img { display: block; max-width: 100%; }
	button, input { font: inherit; }

	.skip-link {
		position: fixed;
		top: .75rem;
		left: .75rem;
		z-index: 100;
		padding: .6rem .9rem;
		background: var(--ink);
		color: white;
		transform: translateY(-160%);
	}
	.skip-link:focus { transform: translateY(0); }

	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: var(--max);
		margin: 0 auto;
		padding: 1rem var(--gutter);
		background: color-mix(in srgb, var(--paper) 86%, transparent);
		border-bottom: 1px solid var(--line);
		backdrop-filter: blur(16px);
	}

	.wordmark { display: inline-flex; align-items: center; gap: .8rem; text-decoration: none; }
	.wordmark-mark {
		display: grid;
		width: 2.25rem;
		height: 2.25rem;
		place-items: center;
		border: 1px solid var(--ink);
		border-radius: 50%;
		font: 600 .68rem/1 var(--mono);
		letter-spacing: -.05em;
	}
	.wordmark-name { font-size: .79rem; font-weight: 650; letter-spacing: -.01em; }
	.header-links { display: flex; align-items: center; gap: clamp(.9rem, 2.2vw, 2rem); }
	.header-links a { color: var(--muted); font: 650 .62rem/1 var(--mono); letter-spacing: .06em; text-decoration: none; text-transform: uppercase; }
	.header-links .header-email { color: var(--ink); text-transform: none; }
	.header-links a:hover { color: var(--ink); text-decoration: underline; text-underline-offset: .35rem; }

	.page-shell { width: min(var(--max), 100%); margin: 0 auto; padding-inline: var(--gutter); }
	.page-hero { min-height: 68vh; padding-block: clamp(5rem, 11vw, 10rem) clamp(4rem, 8vw, 7rem); }
	.page-hero-grid { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(240px, .6fr); gap: 3rem; align-items: end; }
	.page-hero h1, .hero-copy h1 {
		max-width: 13ch;
		margin: 0;
		font: 400 clamp(4rem, 10vw, 9.2rem)/.86 var(--serif);
		letter-spacing: -.075em;
	}
	.page-hero .lede { max-width: 37rem; margin: 0 0 .55rem; color: var(--muted); font-size: clamp(1.02rem, 1.8vw, 1.3rem); }
	.eyebrow {
		margin: 0 0 1.2rem;
		font: 650 .68rem/1.2 var(--mono);
		letter-spacing: .13em;
		text-transform: uppercase;
	}
	.eyebrow::before { display: inline-block; width: 1.6rem; height: 1px; margin: 0 .65rem .22rem 0; background: currentColor; content: ''; }
	.accent { color: var(--orange); }
	.serif { font-family: var(--serif); }
	.muted { color: var(--muted); }

	.btn-row { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 2rem; }
	.btn {
		display: inline-flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		min-width: 10rem;
		padding: .85rem 1rem;
		border: 1px solid var(--ink);
		border-radius: 999px;
		font-size: .72rem;
		font-weight: 650;
		letter-spacing: .07em;
		text-decoration: none;
		text-transform: uppercase;
		transition: color .2s, background .2s, transform .2s;
	}
	.btn:hover { color: var(--paper); background: var(--ink); transform: translateY(-2px); }
	.btn.primary { color: white; background: var(--ink); }
	.btn.primary:hover { background: var(--violet); border-color: var(--violet); }

	.rule { border-top: 1px solid var(--line); }
	.section { padding-block: clamp(5rem, 11vw, 10rem); scroll-margin-top: 5rem; }
	.section-head { display: grid; grid-template-columns: 1fr 2fr; gap: 2rem; margin-bottom: clamp(3rem, 7vw, 6rem); }
	.section-head h2 { max-width: 9ch; margin: 0; font: 400 clamp(2.8rem, 6.4vw, 6rem)/.91 var(--serif); letter-spacing: -.055em; }
	.section-intro { max-width: 42rem; margin: .3rem 0 0 auto; color: var(--muted); font-size: clamp(1.05rem, 1.6vw, 1.32rem); }

	.text-link {
		display: inline-flex;
		align-items: center;
		gap: .7rem;
		font-size: .72rem;
		font-weight: 700;
		letter-spacing: .08em;
		text-decoration-thickness: 1px;
		text-underline-offset: .35rem;
		text-transform: uppercase;
	}
	.text-link span { transition: transform .2s; }
	.text-link:hover span { transform: translateX(.28rem); }

	.tag-list { display: flex; flex-wrap: wrap; gap: .45rem; padding: 0; margin: 1.4rem 0 0; list-style: none; }
	.tag-list li { padding: .38rem .62rem; border: 1px solid var(--line); border-radius: 999px; color: var(--muted); font: 600 .62rem/1 var(--mono); text-transform: uppercase; }

	.site-footer {
		display: grid;
		grid-template-columns: 1.3fr 1fr;
		gap: clamp(2rem, 7vw, 7rem);
		max-width: var(--max);
		margin: 0 auto;
		padding: clamp(4rem, 8vw, 7rem) var(--gutter) 3rem;
		border-top: 1px solid var(--line);
	}
	.footer-title { max-width: 15ch; margin: 0; font: 400 clamp(1.8rem, 3.8vw, 3.7rem)/1 var(--serif); letter-spacing: -.045em; }
	.footer-side { display: flex; flex-direction: column; justify-content: space-between; gap: 3rem; }
	.footer-links { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: .7rem 1.4rem; }
	.footer-links a { font: 650 .62rem/1.4 var(--mono); letter-spacing: .06em; text-underline-offset: .3rem; text-transform: uppercase; }
	.footer-meta { display: grid; justify-content: end; color: var(--muted); font: .62rem/1.7 var(--mono); text-align: right; text-transform: uppercase; }
	.footer-meta p { margin: 0; }

	.prose { max-width: 760px; margin-inline: auto; }
	.prose h2 { margin: 4rem 0 1.25rem; font: 400 clamp(2rem, 4vw, 3.5rem)/1 var(--serif); letter-spacing: -.045em; }
	.prose h3 { margin: 2.5rem 0 .8rem; font-size: 1rem; }
	.prose p, .prose li { color: #373a36; font-size: clamp(1rem, 1.4vw, 1.16rem); line-height: 1.75; }
	.prose a { text-underline-offset: .22rem; }
	.prose blockquote { margin: 3rem 0; padding-left: 1.4rem; border-left: 2px solid var(--orange); font: 400 clamp(1.5rem, 3vw, 2.45rem)/1.22 var(--serif); }
	.prose blockquote p { color: var(--ink); font: inherit; }

	@media (max-width: 820px) {
		body { background: var(--paper); }
		.wordmark-name { display: none; }
		.header-links { gap: .8rem; }
		.header-links a { font-size: .55rem; }
		.page-hero-grid, .section-head, .site-footer { grid-template-columns: 1fr; }
		.page-hero { min-height: auto; }
		.page-hero h1 { font-size: clamp(3.8rem, 17vw, 6.5rem); }
		.section-intro { margin-left: 0; }
		.footer-links { justify-content: flex-start; }
		.footer-meta { justify-content: start; text-align: left; }
	}

	@media (max-width: 600px) {
		.header-email { font-size: 0 !important; }
		.header-email::after { font-size: .55rem; content: 'Email'; text-transform: uppercase; }
	}

	@media (prefers-reduced-motion: reduce) {
		html { scroll-behavior: auto; }
		*, *::before, *::after { animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; }
	}

	@media print {
		.site-header, .site-footer, .no-print { display: none !important; }
		body { background: white; color: black; }
	}
</style>
